---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
			<main>
				<h2 style="und">Hi, I'm Kirin.</h2>
				<div class="box">
					<h4>A little about me</h4>
					<p>
						I'm a second year Cyber Security student at Lancaster University aiming for a career in red teaming. <br> <br> I run a Proxmox homelab with a variety of selfhosted services connected and secured over Tailscale. I build my skills on TryHackMe and Udemy, code in Python, C, C++, C# and Javascript. I also organised and ran my own employer-student event and have spoken publicly at multiple events, giving me experience leading projects and discussions, alongside communicating with both technical and non-technical audiences.
					</p>
					<a href="/about" class="btn">Read more</a>
				</div>
				<div class="box">
					<h4>Featured Project</h4>
					<p>
						This is a really cool featured project, how awesome!
					</p>
					<a href="/projects" class="btn">See more projects</a>
				</div>
				<div class="box">
					<h4>My Links</h4>
					<p>
						<a href="/projects">See my projects</a> ·
						<a href="/CV.pdf">Download CV</a> ·
						<a href="https://github.com/yourusername">GitHub</a> ·
						<a href="https://linkedin.com/in/yourprofile">LinkedIn</a>
					</p>
				</div>
			</main>
		<Footer />
	</body>
</html>
