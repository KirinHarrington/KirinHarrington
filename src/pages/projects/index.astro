---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Projects | ${SITE_TITLE}`} description="Things I've built and broken." />
    <style>
      ul { list-style: none; padding: 0; display: grid; gap: 1rem; }
      li a { display: block; padding: 1.25rem; border: 1px solid rgb(var(--gray-light)); border-radius: 8px; text-decoration: none; }
      li a:hover { border-color: var(--accent); }
      h2 { margin: 0 0 0.25rem; }
      .tags { color: rgb(var(--gray)); font-size: 0.85rem; margin: 0.5rem 0 0; }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Projects</h1>
      <ul>
        {projects.map((p) => (
          <li>
            <a href={`/projects/${p.id}/`}>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <p class="tags">{p.data.tags.join(' · ')}</p>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>